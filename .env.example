# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── GitHub 登录（专业版功能需要）─────────────────
# GitHub → Settings → Developer settings → OAuth Apps 里创建后获取
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 会话签名密钥，务必改成随机长串：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# 专业版白名单：逗号分隔的 GitHub 用户名
PRO_USERS=
